# Local run only. On Clever Cloud, the linked Cellar add-on injects the three CELLAR_ADDON_* variables.
# A local S3 stands in for Cellar: uvx --from "moto[server]" moto_server -p 9100
CELLAR_ADDON_HOST=http://localhost:9100
CELLAR_ADDON_KEY_ID=local-key-id
CELLAR_ADDON_KEY_SECRET=local-key-secret
# Optional
# CELLAR_BUCKET=darkroom-local
# CORS_ORIGINS=https://darkroom.example.com
PORT=8080
